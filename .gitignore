# ─── Large Binary / Data Files (exceeds GitHub 100 MB limit) ──────────────────

# Raw network captures & flows
*.pcap
*.pcapng
*.pcap.gz
*.binetflow
*.part
*.cap

# Uploaded user files
data/uploads/
uploads/

# Full UNSW-NB15 dataset (multi-GB)
data/UNSW-NB15 Dataset/

# Processed Parquet windows (large training sets)
data/processed/*_windows*.parquet
data/processed/test_windows.parquet
data/processed/train_windows.parquet
data/processed/val_windows.parquet
data/processed/train_windows_finetune.parquet
data/processed/train_windows_full.parquet
data/processed/val_windows_full.parquet

# Large CSV datasets
data/UNSW-NB15*/
data/**/*.csv

# Model weights — KEEP tracked for deployment!
# Only ignore extremely large weights (>100 MB) by name if needed.
# models/*.pt        # DO NOT IGNORE — required for inference
# models/*.onnx      # DO NOT IGNORE — required for deployment
# models/*.joblib    # DO NOT IGNORE — required for inference

# Scaler files — KEEP tracked (tiny files critical for feature normalization)
# data/processed/scaler.joblib   # DO NOT IGNORE

# Artifacts / checkpoints — keep model checkpoints tracked
# artifacts/          # DO NOT IGNORE — contains trained model checkpoints
